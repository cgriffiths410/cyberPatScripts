# Define the new password
$newPassword = "P@ssw0rd:RBR!@#"

# Get all local user accounts
$users = Get-LocalUser

# Get members of the local Administrators group
$adminGroup = Get-LocalGroupMember -Group "Administrators" | Select-Object -ExpandProperty Name

foreach ($user in $users) {
    try {
        # Skip accounts that are disabled OR in Administrators group
        if ($user.Enabled -and ($adminGroup -notcontains $user.Name)) {
            # Set the new password
            $securePassword = ConvertTo-SecureString $newPassword -AsPlainText -Force
            $user | Set-LocalUser -Password $securePassword
            Write-Host "Password for $($user.Name) changed successfully."
        } else {
            Write-Host "Skipped account: $($user.Name)"
        }
    } catch {
        Write-Host "Failed to change password for $($user.Name): $_"
    }
}
