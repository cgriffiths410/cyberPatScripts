Write-Host "==========================================" -ForegroundColor Cyan
Write-Host "FIRST OUTPUT SECTION: NON-DEFAULT SMB SHARES" -ForegroundColor Cyan
Write-Host "==========================================" -ForegroundColor Cyan

$ExcludedShares = @("ADMIN$", "C$", "IPC$")

$Shares = Get-SmbShare | Where-Object {
    $_.Name -notin $ExcludedShares -and $_.ShareState -eq "Online"
}

if ($Shares.Count -eq 0) {
    Write-Host "No non-default SMB shares found." -ForegroundColor Yellow
} else {
    foreach ($Share in $Shares) {
        Write-Host "`nShare Name: $($Share.Name)" -ForegroundColor Green
        Write-Host "Path: $($Share.Path)" -ForegroundColor Gray

        if (Test-Path $Share.Path) {
            try {
                Get-ChildItem -Path $Share.Path -Recurse -Force -ErrorAction Stop |
                Select-Object FullName, Attributes
            } catch {
                Write-Host "Access denied or error reading contents." -ForegroundColor Red
            }
        } else {
            Write-Host "Share path does not exist." -ForegroundColor Red
        }
    }
}

Write-Host "`n==========================================" -ForegroundColor Cyan
Write-Host "SECOND OUTPUT SECTION: HIDDEN FILES (FILTERED EXTENSIONS)" -ForegroundColor Cyan
Write-Host "==========================================" -ForegroundColor Cyan

$AllowedExtensions = @(".exe", ".txt", ".csv", ".wav", ".zip")
$ExcludedPath = "C:\CyberPatriot"

Write-Host "`n--- Hidden Drives ---" -ForegroundColor Green
Get-PSDrive -PSProvider FileSystem |
Where-Object {
    $_.Root -and (Get-Item $_.Root -Force -ErrorAction SilentlyContinue).Attributes -match "Hidden"
} |
Select-Object Name, Root

Write-Host "`n--- Hidden Files with Allowed Extensions (Excluding C:\CyberPatriot) ---" -ForegroundColor Green

$Drives = Get-PSDrive -PSProvider FileSystem | Where-Object { $_.Free -ne $null }

foreach ($Drive in $Drives) {
    Write-Host "`nScanning Drive: $($Drive.Name):\" -ForegroundColor Gray
    try {
        Get-ChildItem "$($Drive.Name):\" -Recurse -Force -ErrorAction SilentlyContinue |
        Where-Object {
            -not $_.PSIsContainer -and
            $_.Attributes -match "Hidden" -and
            $AllowedExtensions -contains $_.Extension.ToLower() -and
            $_.FullName -notlike "$ExcludedPath*"
        } |
        Select-Object FullName, Extension, Attributes
    } catch {
        Write-Host "Error scanning drive $($Drive.Name)" -ForegroundColor Red
    }
}

