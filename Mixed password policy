# =========================================================
# ACCOUNT LOCKOUT POLICY
# =========================================================

# Threshold (invalid logon attempts before lockout)
$threshold = 10

# Lockout duration in minutes
$lockoutDuration = 15

# Observation window in minutes
$observationWindow = 15

# Apply lockout settings
cmd /c "net accounts /lockoutthreshold:$threshold /lockoutduration:$lockoutDuration /lockoutwindow:$observationWindow"

Write-Host "=== Account Lockout Policy Updated ===" -ForegroundColor Cyan
Write-Host "  Threshold: $threshold attempts"
Write-Host "  Duration: $lockoutDuration minutes"
Write-Host "  Observation Window: $observationWindow minutes"
Write-Host ""


# =========================================================
# LIMIT BLANK PASSWORDS (LOCAL ACCOUNTS) TO CONSOLE LOGON ONLY
# =========================================================

Write-Host "=== Enforcing 'Limit local account use of blank passwords to console logon only' ===" -ForegroundColor Cyan

$lsaPath = "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa"

# Ensure the registry path exists
if (-not (Test-Path $lsaPath)) {
    New-Item -Path $lsaPath -Force | Out-Null
}

# Enable the restriction
Set-ItemProperty -Path $lsaPath -Name "LimitBlankPasswordUse" -Type DWord -Value 1 -Force

Write-Host "Setting applied: LimitBlankPasswordUse = 1 (Enabled)" -ForegroundColor Green
Write-Host "Blank-password accounts can now log on ONLY at the physical console." -ForegroundColor Yellow
Write-Host "Network, RDP, and remote logons using blank passwords are blocked." -ForegroundColor Yellow
Write-Host ""


# =========================================================
# PASSWORD COMPLEXITY CONFIGURATION
# (Minimum length + maximum age)
# =========================================================

# Minimum password length
$minLength = 10

# Maximum password age (days)
$maxAge = 90

# Apply password settings
cmd /c "net accounts /minpwlen:$minLength"
cmd /c "net accounts /maxpwage:$maxAge"

# Get current policy info
$output = cmd /c "net accounts"

$verifyMin = ($output | Select-String "Minimum password length")
$verifyMax = ($output | Select-String "Maximum password age")

Write-Host "=== Password Policy Updated ===" -ForegroundColor Cyan
Write-Host "  $verifyMin"
Write-Host "  $verifyMax"
Write-Host ""
Write-Host "Password length and aging requirements are now enforced." -ForegroundColor Green
