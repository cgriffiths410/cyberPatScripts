# ====================================================================
# Windows Security Feature Enabler (Auto Updates)
# ====================================================================

Write-Host "`n===== Starting Windows Security Hardening =====`n" -ForegroundColor Cyan

# --- Check for Administrative Privileges ---
if (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole(
    [Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Host "Please run this script as Administrator." -ForegroundColor Red
    exit
}

# --- 1. Firewall ---
Write-Host "`n[1] Firewall Settings" -ForegroundColor Yellow
try {
    $fwProfiles = Get-NetFirewallProfile
    foreach ($profile in $fwProfiles) {
        if (-not $profile.Enabled) {
            Set-NetFirewallProfile -Name $profile.Name -Enabled True -ErrorAction Stop
            Write-Host "Firewall ($($profile.Name)) was enabled." -ForegroundColor Green
        } else {
            Write-Host "Firewall ($($profile.Name)) is already secure." -ForegroundColor Green
        }
    }
} catch {
    Write-Host "Firewall configuration failed: $($_.Exception.Message)" -ForegroundColor Red
}

# --- 2. Virus & Threat Protection ---
Write-Host "`n[2] Virus & Threat Protection" -ForegroundColor Yellow
try {
    Set-MpPreference -DisableRealtimeMonitoring $false -ErrorAction SilentlyContinue
    Start-Sleep -Seconds 2
    $avStatus = (Get-MpComputerStatus).RealTimeProtectionEnabled

    if ($avStatus) {
        Write-Host "Real-Time Protection is active." -ForegroundColor Green
    } else {
        Write-Host "Real-Time Protection could not be enabled." -ForegroundColor Yellow
    }

    # Ransomware Protection
    $ransomStatus = (Get-MpPreference).EnableControlledFolderAccess
    if ($null -eq $ransomStatus -or $ransomStatus -eq 0) {
        Set-MpPreference -EnableControlledFolderAccess Enabled -ErrorAction SilentlyContinue
        Start-Sleep -Seconds 2
        $ransomStatus = (Get-MpPreference).EnableControlledFolderAccess
    }

    switch ($ransomStatus) {
        1 { Write-Host "Ransomware Protection is active." -ForegroundColor Green }
        2 { Write-Host "Ransomware Protection in Audit Mode." -ForegroundColor Yellow }
        Default { Write-Host "Ransomware Protection could not be enabled." -ForegroundColor Yellow }
    }
} catch {
    Write-Host "Virus & Threat Protection error: $($_.Exception.Message)" -ForegroundColor Red
}

# --- 3. Device Security (Memory Integrity / Core Isolation) ---
Write-Host "`n[3] Device Security (Memory Integrity)" -ForegroundColor Yellow
try {
    $ciKey = "HKLM:\SYSTEM\CurrentControlSet\Control\DeviceGuard\Scenarios\HypervisorEnforcedCodeIntegrity"
    if (Test-Path $ciKey) {
        $ciValue = (Get-ItemProperty -Path $ciKey -Name Enabled -ErrorAction SilentlyContinue).Enabled
        if ($ciValue -ne 1) {
            Set-ItemProperty -Path $ciKey -Name Enabled -Value 1 -Force
            Write-Host "Memory Integrity enabled (reboot required)." -ForegroundColor Green
        } else {
            Write-Host "Memory Integrity already enabled." -ForegroundColor Green
        }

        $deviceGuard = Get-CimInstance -ClassName Win32_DeviceGuard -ErrorAction SilentlyContinue
        if ($null -ne $deviceGuard) {
            $hvciActive = $deviceGuard.SecurityServicesRunning -contains 1
            if (-not $hvciActive) {
                Write-Host "Memory Integrity not active (reboot or driver conflict)." -ForegroundColor Yellow
            } else {
                Write-Host "Memory Integrity active." -ForegroundColor Green
            }
        }
    } else {
        Write-Host "Memory Integrity not supported on this system." -ForegroundColor Yellow
    }
} catch {
    Write-Host "Device Security error: $($_.Exception.Message)" -ForegroundColor Red
}

# --- 4. App & Browser Control ---
Write-Host "`n[4] App & Browser Control" -ForegroundColor Yellow
try {
    # SmartScreen
    $smartscreenPath = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer"
    $appHostPath     = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\AppHost"

    New-ItemProperty -Path $smartscreenPath -Name SmartScreenEnabled -PropertyType String -Value "RequireAdmin" -Force | Out-Null
    New-ItemProperty -Path $appHostPath -Name EnableWebContentEvaluation -PropertyType DWord -Value 1 -Force | Out-Null
    New-ItemProperty -Path $appHostPath -Name PreventOverride -PropertyType DWord -Value 1 -Force | Out-Null

    Write-Host "SmartScreen settings configured." -ForegroundColor Green

    # Exploit Protection
    $exploit = Get-ProcessMitigation -System
    if ($exploit) {
        Set-ProcessMitigation -System -Enable DEP,ForceRelocateImages,RequireInfo,BottomUp,HighEntropy,SEHOP -ErrorAction SilentlyContinue
        Write-Host "Exploit Protection mitigations applied." -ForegroundColor Green
    }
} catch {
    Write-Host "App & Browser Control error: $($_.Exception.Message)" -ForegroundColor Red
}

# --- 5. Windows Automatic Updates ---
Write-Host "`n[5] Automatic Windows Updates" -ForegroundColor Yellow
try {
    $wuPolicyPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU"
    if (!(Test-Path $wuPolicyPath)) {
        New-Item -Path $wuPolicyPath -Force | Out-Null
    }

    # Enable Automatic Updates
    New-ItemProperty -Path $wuPolicyPath -Name "NoAutoUpdate" -PropertyType DWord -Value 0 -Force | Out-Null
    New-ItemProperty -Path $wuPolicyPath -Name "AUOptions"   -PropertyType DWord -Value 4 -Force | Out-Null

    Write-Host "Automatic Updates enabled and configured securely." -ForegroundColor Green
} catch {
    Write-Host "Automatic Updates configuration error: $($_.Exception.Message)" -ForegroundColor Red
}

Write-Host "`n===== Security Configuration Completed =====`n" -ForegroundColor Cyan
